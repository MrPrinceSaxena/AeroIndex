# Environment -- never commit credentials
.env
.env.example
# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/

# Playwright browser binaries (large, installed per-machine)
.playwright/

# Raw scraped data -- too large / potentially sensitive for git
data/raw/

# Pipeline outputs -- regenerated by running cleaning/pipeline.py and
# plot_sanity_check.py; not source content, so not committed
data/clean/*.csv
data/clean/*.png

# IDE
.idea/
.vscode/
*.swp
.DS_Store

# Streamlit cache
.streamlit/

# Pytest cache
.pytest_cache/
.coverage
htmlcov/

# Frontend (Vite + React)
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local

# Claude Code local/personal settings (not shared team config)
.claude/settings.local.json
